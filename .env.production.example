# Configurações de Produção para Deploy em VPS (Hostinger / DigitalOcean / AWS)

# 1. Banco de Dados PostgreSQL
POSTGRES_USER=copperos
POSTGRES_PASSWORD=sua_senha_super_segura_de_producao_123
POSTGRES_DB=copperos_db

# 2. Segredos JWT
JWT_ACCESS_SECRET=chave_secreta_longa_e_aleatoria_para_access_token_minimo_32_chars
JWT_REFRESH_SECRET=chave_secreta_longa_e_aleatoria_para_refresh_token_minimo_32_chars

# 3. Domínio ou IP da sua VPS Hostinger (ex: http://seu-ip ou https://seu-dominio.com)
CLIENT_URL=http://localhost
