PORT=3333
NODE_ENV=development

# Conexão com o banco PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/auth_db?schema=public"

# Secrets para assinatura dos tokens JWT
JWT_ACCESS_SECRET="sua_chave_secreta_super_segura_para_access_token_123"
JWT_REFRESH_SECRET="sua_chave_secreta_super_segura_para_refresh_token_456"

# Tempos de expiração
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_DAYS=7

# Origem permitida para o CORS (frontend)
CLIENT_URL="http://localhost:5173"
