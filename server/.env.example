PORT=3333
NODE_ENV=development

# Conexão com o banco PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/auth_db?schema=public"

# Secrets para assinatura dos tokens JWT
JWT_ACCESS_SECRET="troque_por_32_bytes_aleatorios_ex_openssl_rand_hex_32_aaaaaaaa"
JWT_REFRESH_SECRET="troque_por_outro_valor_distinto_openssl_rand_hex_32_bbbbbbbb"

# Tempos de expiração
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_DAYS=7

# Origem permitida para o CORS (frontend)
CLIENT_URL="http://localhost:5173"

# Proxies confiáveis à frente da API (0 = nenhum).
# Só aumente se houver de fato um reverse proxy: confiar em X-Forwarded-For sem
# proxy real permite burlar o rate limit por IP com header falsificado.
TRUST_PROXY=0
